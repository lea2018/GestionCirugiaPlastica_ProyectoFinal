        _mensajeEsError = esError;
    }

    private void CerrarMensaje() => _mensaje = null;

    // ───────────────────────── Utilidades de vista ─────────────────────────
    private static string Iniciales(PacienteModel p)
    {
        string n = string.IsNullOrWhiteSpace(p.Nombre) ? "" : p.Nombre.Trim()[..1];
        string a = string.IsNullOrWhiteSpace(p.Apellido) ? "" : p.Apellido.Trim()[..1];
        return (n + a).ToUpperInvariant();
    }

    private static int? CalcularEdad(DateOnly? nacimiento)
    {
        if (nacimiento is null) return null;

        var hoy = DateOnly.FromDateTime(DateTime.Today);
        int edad = hoy.Year - nacimiento.Value.Year;
        if (nacimiento.Value > hoy.AddYears(-edad)) edad--;

        return edad < 0 ? null : edad;
    }

    // ───────────────────────── Lectura de la respuesta de la API ─────────────────────────
    // La API responde con un Result: { isSuccess, isFailure, value, error: { code, description } }.
    // Esta lectura es tolerante: también entiende ProblemDetails (400 de validación) y cuerpos vacíos (404).
    private sealed record ApiResultado(bool Exito, string Mensaje, JsonElement? Valor);

    private static async Task<ApiResultado> LeerAsync(HttpResponseMessage respuesta)
    {
        string texto = await respuesta.Content.ReadAsStringAsync();
        bool exitoHttp = respuesta.IsSuccessStatusCode;

        if (string.IsNullOrWhiteSpace(texto))
        {
            string vacio = exitoHttp ? "" : MensajePorEstado(respuesta.StatusCode);
            return new ApiResultado(exitoHttp, vacio, null);
        }

        try
        {
            using var doc = JsonDocument.Parse(texto);
            var raiz = doc.RootElement;

            if (raiz.ValueKind != JsonValueKind.Object)
                return new ApiResultado(exitoHttp, exitoHttp ? "" : MensajePorEstado(respuesta.StatusCode), null);

            bool exito = exitoHttp;
            if (Propiedad(raiz, "isSuccess") is { ValueKind: JsonValueKind.True or JsonValueKind.False } ok)
                exito = exitoHttp && ok.GetBoolean();

            JsonElement? valor = Propiedad(raiz, "value") is { } v ? v.Clone() : null;

            string mensaje = exito ? "" : ExtraerError(raiz) ?? MensajePorEstado(respuesta.StatusCode);
            return new ApiResultado(exito, mensaje, valor);
        }
        catch (JsonException)
        {
            return new ApiResultado(exitoHttp, exitoHttp ? "" : MensajePorEstado(respuesta.StatusCode), null);
        }
    }

    private static string? ExtraerError(JsonElement raiz)
    {
        // Result.Failure → "error": { "code": "...", "description": "..." }
        if (Propiedad(raiz, "error") is { ValueKind: JsonValueKind.Object } error)
        {
            string? texto = TextoDe(error, "description") ?? TextoDe(error, "message") ?? TextoDe(error, "code");
            if (texto is not null) return texto;
        }

        // ProblemDetails de validación → "errors": { "Campo": ["mensaje"] }
        if (Propiedad(raiz, "errors") is { ValueKind: JsonValueKind.Object } errores)
        {
            var mensajes = errores.EnumerateObject()
                .SelectMany(p => p.Value.ValueKind == JsonValueKind.Array ? p.Value.EnumerateArray() : Enumerable.Empty<JsonElement>())
                .Where(x => x.ValueKind == JsonValueKind.String)
                .Select(x => x.GetString())
                .Where(x => !string.IsNullOrWhiteSpace(x));

            string unido = string.Join(" ", mensajes);
            if (unido.Length > 0) return unido;
        }

        return TextoDe(raiz, "detail") ?? TextoDe(raiz, "title") ?? TextoDe(raiz, "message");
    }

    private static string? TextoDe(JsonElement objeto, string nombre) =>
        Propiedad(objeto, nombre) is { ValueKind: JsonValueKind.String } e && !string.IsNullOrWhiteSpace(e.GetString())
            ? e.GetString()
            : null;

    private static JsonElement? Propiedad(JsonElement objeto, string nombre)
    {
        foreach (var p in objeto.EnumerateObject())
            if (p.Name.Equals(nombre, StringComparison.OrdinalIgnoreCase))
                return p.Value;

        return null;
    }

    private static string MensajePorEstado(HttpStatusCode estado) => estado switch
    {
        HttpStatusCode.NotFound => "No se encontró el registro solicitado.",
        HttpStatusCode.Conflict => "La operación no se pudo completar porque el registro tiene datos relacionados.",
        HttpStatusCode.BadRequest => "La solicitud no es válida.",
        _ => $"Error del servidor ({(int)estado})."
    };

    // ───────────────────────── Modelo del formulario ─────────────────────────
    // Refleja la entidad Paciente de la API (sin las colecciones de navegación).
    public class PacienteModel
    {
        public int PacienteId { get; set; }

        public DateTime FechaRegistro { get; set; }

        [Required(ErrorMessage = "El nombre es obligatorio.")]
        [StringLength(250, ErrorMessage = "Máximo 250 caracteres.")]
        public string Nombre { get; set; } = "";

        [Required(ErrorMessage = "El apellido es obligatorio.")]
        [StringLength(250, ErrorMessage = "Máximo 250 caracteres.")]
        public string Apellido { get; set; } = "";

        [StringLength(20, ErrorMessage = "Máximo 20 caracteres.")]
        public string? Cedula { get; set; }

        public DateOnly? FechaNacimiento { get; set; }

        public string? Sexo { get; set; }

        public bool TieneSeguro { get; set; }

        public int? PacienteSeguroId { get; set; }

        public int? SeguroId { get; set; }

        public string? SeguroNombre { get; set; }

        public string? NumeroPoliza { get; set; }

        [StringLength(250, ErrorMessage = "Máximo 250 caracteres.")]
        public string? Telefono { get; set; }

        [EmailAddress(ErrorMessage = "El correo no es válido.")]
        [StringLength(250, ErrorMessage = "Máximo 250 caracteres.")]
        public string? Email { get; set; }

        [StringLength(250, ErrorMessage = "Máximo 250 caracteres.")]
        public string? Direccion { get; set; }

        public PacienteModel Clonar() => (PacienteModel)MemberwiseClone();

        // Prepara el objeto para enviarlo a la API: recorta espacios y convierte vacíos en null.
        // Es importante con la cédula, porque tiene índice único y dos "" chocarían entre sí.
        public PacienteModel Normalizar()
        {
            var copia = Clonar();
            copia.Nombre = Nombre.Trim();
            copia.Apellido = Apellido.Trim();
            copia.Cedula = Limpiar(Cedula);
            copia.Telefono = Limpiar(Telefono);
            copia.Email = Limpiar(Email);
            copia.Direccion = Limpiar(Direccion);

            if (copia.FechaRegistro == default)
                copia.FechaRegistro = DateTime.Now;

            return copia;
        }

        private static string? Limpiar(string? valor) =>
            string.IsNullOrWhiteSpace(valor) ? null : valor.Trim();
    }

